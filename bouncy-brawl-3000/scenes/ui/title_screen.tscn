[node name="ControlsText" type="Label" parent="ControlsModal/ModalFrame/VBox" unique_id=457735684]
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.93, 0.98, 1)
theme_override_font_sizes/font_size = 13
text = "KEYBOARD:
• A / D or Left / Right: Move & air control
• Space: Jump (Double-tap in air for air jump)
• S + Space: Drop through one-way platform
• J or Z: Melee Attack (deals 15 dmg, adds 8% knockback, costs 18 stamina)
• Esc or P: Pause Game

CONTROLLER (Xbox / PlayStation / Generic):
• Left Stick / D-Pad: Move & air control
• A / Cross: Jump (Double-tap for air jump)
• Down + A / Cross: Drop through one-way platform
• X / Square: Melee Attack
• Start / Options: Pause Game

ARENA MECHANICS:
• Knockback % increases after every hit taken!
• Higher Knockback = farther launch distance!
• Bounce Platforms below: Launch you back up into the arena!
• Periodic Heal: Golden tick restores +15 HP every 30s!"

